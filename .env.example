APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
SEC_USER_AGENT=Your Name your-email@example.com
FRED_API_KEY=

# Local dbt development configuration
DBT_GCP_PROJECT_ID=replace-with-your-gcp-project-id
DBT_GCP_LOCATION=asia-southeast2
DBT_RAW_DATASET=equity_raw
DBT_ANALYTICS_DATASET=equity_analytics

# Local Docker Compose configuration
